{
  "name": "@gjlmotea/studio-sidecar-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Studio Sidecar: companion MCP server for Roblox Studio's built-in MCP (StudioMCP). Opens places, manages StudioMCP broker and stub processes, guards writes by PlaceId, runs Luau past the 100k output limit, and uploads, updates or archives assets through Roblox Open Cloud. No Studio plugin.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "studio-mcp",
    "studiomcp",
    "luau",
    "open-cloud",
    "opencloud",
    "roblox-open-cloud",
    "roblox-assets",
    "asset-upload",
    "place",
    "claude-code",
    "codex",
    "ai-agent",
    "game-development"
  ],
  "license": "MIT",
  "author": "gjlmotea",
  "homepage": "https://github.com/gjlmotea/studio-sidecar-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjlmotea/studio-sidecar-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gjlmotea/studio-sidecar-mcp/issues"
  },
  "mcpName": "io.github.gjlmotea/studio-sidecar-for-roblox-studio-mcp",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "bin": {
    "studio-sidecar-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/stdio-smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:extract": "node scripts/verify-extract-live.mjs",
    "start": "node dist/index.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
