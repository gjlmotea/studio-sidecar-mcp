# Open Cloud API Key。需要 Creator Dashboard → Open Cloud API Keys 的 Asset → read + write。
# 真金鑰不進這個檔；vibe/roblox/.env.shared 已有一把可跨機器共用的。
ROBLOX_API_KEY=

# 上傳時填進 creationContext 的建立者。省略時 roblox_upload_asset 必須自己帶 creatorUserId。
ROBLOX_CREATOR_USER_ID=

# 允許上傳的來源目錄（可多個，用平台的 PATH 分隔符分隔）。
# 沒設定時 roblox_upload_asset 一律拒絕 —— 不讓 MCP Client 指定任意檔案路徑。
ROBLOX_UPLOAD_ROOT=

# Roblox Studio 執行檔路徑。省略時自動解析：
# Windows 取 %LOCALAPPDATA%\Roblox\Versions 下「同時帶著 RobloxStudioBeta.exe」的版本目錄，
# macOS 取 /Applications/RobloxStudio.app/Contents/MacOS/RobloxStudio。
ROBLOX_STUDIO_PATH=
